# Copy to .env and fill in real values for local development.
# Never commit .env or real secrets — see .gitignore.

# development | production | test
NODE_ENV=development

# HTTP port the Nest application listens on.
PORT=3000

# PostgreSQL connection string. Must start with postgres:// or postgresql://.
# Local example (adjust user/password/db to your setup):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plaza_backend_dev?schema=public"

# Separate database used only by integration/e2e tests (see README "Tests").
# Never point this at a production or shared database — test setup/teardown
# is destructive within this database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plaza_backend_test?schema=public"

# Comma-separated list of allowed CORS origins, e.g. "https://app.example.com".
# Leave unset/empty to disable cross-origin requests entirely (safe default —
# no frontend origin is approved yet; see docs/backend-architecture.md §10).
CORS_ORIGIN=

# Set to "false" to disable the /docs Swagger UI (recommended in production
# unless explicitly required). Defaults to enabled outside production.
SWAGGER_ENABLED=true

# error | warn | log | debug | verbose — minimum level the application logs.
LOG_LEVEL=log

# --- Authentication (Phase 2) ---

# At least 32 random characters. Generate with: openssl rand -base64 48
# There is no fallback/default — the app refuses to start without a real one.
JWT_ACCESS_SECRET=

# Access token lifetime. Short by design — session revocation/deactivation is
# rechecked from the database on every request regardless (see
# docs/adr/0009-per-request-session-revalidation.md), so a short access token
# adds defense in depth without being the only revocation mechanism.
JWT_ACCESS_TTL=15m

# Included as the JWT "iss"/"aud" claims and validated on every verification
# (rejects a token issued for a different deployment/audience).
JWT_ISSUER=euro-plaza-backend
JWT_AUDIENCE=euro-plaza-frontend

# How long an issued refresh token (and its session) remains valid without
# activity. Rotated on every successful /auth/refresh.
REFRESH_TOKEN_TTL=30d

# --- Attachment storage (Phase 9) ---

# "local" (a plain filesystem directory — fine for dev/test/single-box
# deployments) or "s3" (any S3-compatible endpoint: real AWS S3, MinIO,
# Supabase Storage). Defaults to "local".
STORAGE_DRIVER=local

# Only read when STORAGE_DRIVER=local. Relative paths resolve against the
# process's working directory. Must not be publicly web-served.
STORAGE_LOCAL_ROOT=./storage/attachments

# Only read when STORAGE_DRIVER=s3. S3_ENDPOINT is optional for real AWS S3
# (the SDK resolves it from S3_REGION); set it for MinIO/Supabase-style
# endpoints. S3_FORCE_PATH_STYLE=true is usually required for those too
# (they expect https://host/bucket/key, not AWS's own bucket-subdomain form).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Upper bound on one uploaded attachment, in bytes. Defaults to 10 MiB.
ATTACHMENT_MAX_SIZE_BYTES=10485760

# How long a never-linked upload may exist before the orphan cleanup job may
# remove it (see AttachmentsCleanupService).
ATTACHMENT_ORPHAN_TTL=24h
